{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%;">
        <div class="card-body">
            <h2 class="text-center mb-4">Change Password</h2>
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                <div class="form-group">
                    {{ form_label(form.currentPassword, 'Current Password', {'label_attr': {'class': 'font-weight-bold'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control', 'placeholder': 'Enter current password'}}) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.newPassword.first, 'New Password', {'label_attr': {'class': 'font-weight-bold'}}) }}
                    {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Enter new password'}}) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.newPassword.second, 'Confirm New Password', {'label_attr': {'class': 'font-weight-bold'}}) }}
                    {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Re-enter new password'}}) }}
                    {{ form_errors(form.newPassword.second) }}
                </div>

                <button type="submit" class="btn btn-primary btn-block mt-3">Change Password</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        border: none;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
        border-radius: 6px;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .form-control {
        border-radius: 8px;
    }

    h2 {
        color: #333;
    }
</style>
{% endblock %}
