{% extends 'base.html.twig' %}

{% block title %}Hiring!{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="text-center mb-5">Hire an employee</h1>

        <div class="d-flex justify-content-center mb-4">
            <input type="text" id="searchBar" class="form-control w-50 shadow-lg" placeholder="Search by name..." onkeyup="filterCards()">
        </div>

        <div class="row g-4" id="userCards">
            {% for user in users %}
                <div class="col-md-4 user-card">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="card-body text-center p-4">
                            {% if user.image %}
                                <img src="{{ asset('uploads/' ~ user.image) }}" class="rounded-circle border border-3 border-primary mb-3" alt="User image" style="width: 120px; height: 120px; object-fit: cover;">
                            {% else %}
                                <img src="{{ asset('images/default-user.jpg') }}" class="rounded-circle border border-3 border-secondary mb-3" alt="Default user image" style="width: 120px; height: 120px; object-fit: cover;">
                            {% endif %}
                            <h5 class="card-title fw-bold">{{ user.firstname }} {{ user.lastname }}</h5>
                            <div class="d-flex justify-content-center gap-3 mt-3">
                                <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-primary btn-icon">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-success btn-icon">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button type="submit" class="btn btn-danger btn-icon">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                                <a class="btn btn-warning btn-icon">
        <i class="fas fa-briefcase"></i> Hire Me
    </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-muted">No records found</p>
                </div>
            {% endfor %}
        </div>
        {% if is_granted('ROLE_ADMIN') %}
        <div class="text-center mt-5">
            <a href="{{ path('app_employee_register') }}" class="btn btn-primary btn-lg shadow-lg">Create new</a>
        </div>
        {% endif %}
    </div>

    <script>
        function filterCards() {
            let input = document.getElementById('searchBar').value.toLowerCase();
            let cards = document.querySelectorAll('.user-card');

            cards.forEach(card => {
                let name = card.querySelector('.card-title').textContent.toLowerCase();
                card.style.display = name.includes(input) ? 'block' : 'none';
            });
        }
    </script>
{% endblock %}
